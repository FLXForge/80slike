{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "children": {
    "fleet": {
      "like": "invaders/invader/fleet",
      "spawn": "manual"
    },
    "player": {
      "like": "invaders/player/player",
      "spawn": "manual"
    },
    "ufo": {
      "like": "invaders/invader/ufo",
      "spawn": "manual"
    },
    "shield1": {
      "like": "invaders/shield/formation",
      "origin": {
        "x": 68,
        "y": 232
      },
      "spawn": "manual"
    },
    "shield2": {
      "like": "invaders/shield/formation",
      "origin": {
        "x": 208,
        "y": 232
      },
      "spawn": "manual"
    },
    "shield3": {
      "like": "invaders/shield/formation",
      "origin": {
        "x": 348,
        "y": 232
      },
      "spawn": "manual"
    },
    "shield4": {
      "like": "invaders/shield/formation",
      "origin": {
        "x": 488,
        "y": 232
      },
      "spawn": "manual"
    },
    "menu": "invaders/menu/main"
  },
  "behavior": {
    "scripts": [
      "invaders/game"
    ]
  },
  "origin": {
    "x": 320,
    "y": 160
  },
  "size": {
    "width": 640,
    "height": 320
  },
  "delimit": true,
  "states": {
    "initial": "menu",
    "menu": {
      "next": [
        "announce"
      ]
    },
    "announce": {
      "next": [
        "playing"
      ]
    },
    "playing": {
      "next": [
        "respawn",
        "announce",
        "result"
      ]
    },
    "respawn": {
      "next": [
        "playing",
        "result"
      ]
    },
    "result": {
      "next": [
        "menu",
        "announce"
      ]
    }
  }
}
