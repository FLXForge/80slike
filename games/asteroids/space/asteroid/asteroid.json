{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "sounds": {
    "pfooom": "/commons/sounds:asteroids_rock_large"
  },
  "bounds": {
    "mode": "wrap",
    "overflow": true
  },
  "group": "asteroid",
  "behavior": {
    "scripts": [
      "asteroid"
    ]
  },
  "children": {
    "small": {
      "like": "asteroid_small",
      "spawn": "manual"
    },
    "fragment": {
      "like": "asteroid_fragment",
      "spawn": "manual"
    }
  },
  "collisions": {
    "body": {
      "type": "ellipse",
      "size": {
        "width": 32,
        "height": 32
      },
      "with": [
        "ship",
        "asteroid",
        "laser"
      ]
    }
  },
  "mechanics": {
    "type": "direct"
  }
}
