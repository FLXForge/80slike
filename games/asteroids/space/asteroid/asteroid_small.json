      {
        "geometry": [
          {
            "x": 0,
            "y": -8
          },
          {
            "x": 7,
            "y": -5
          },
          {
            "x": 8,
            "y": 2
          },
          {
            "x": 4,
            "y": 8
          },
          {
            "x": -5,
            "y": 6
          },
          {
            "x": -8,
            "y": -1
          },
          {
            "x": -4,
            "y": -7
          }
        ],
        "mode": "close"
      }
    ]
  },
  "size": {
    "width": 16,
    "height": 16
