{
  "$schema": "https://flxforge.github.io/FLXEngine/schemas/object.schema.json",
  "bounds": {
    "mode": "wrap",
    "overflow": false
  },
  "sounds": {
    "pff": "/commons/sounds:asteroids_rock_small"
  },
  "group": "asteroid",
  "behavior": {
    "scripts": [
      "asteroid_small"
    ]
  },
  "children": {
